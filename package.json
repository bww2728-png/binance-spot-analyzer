{
  "name": "binance-spot-analyzer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "build": "npm run build --prefix client",
    "test": "node --test server/tests/*.test.mjs",
    "lint": "npm run lint --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
