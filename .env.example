# نموذج متغيرات البيئة — انسخه إلى .env عند الحاجة
# ملاحظة: الخادم يعمل تلقائياً بقيم افتراضية مدمجة في server/db.js
# اضبط هذه القيم فقط إذا أردت استخدام مشروع Supabase مختلف.
SUPABASE_URL=https://<your-supabase-project-url>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# اختياري: فترة المزامنة الدورية لقائمة العملات بالدقائق (افتراضي 30)
SYMBOLS_SYNC_MIN=30

# اختياري: منفذ الخادم (افتراضي 8787 محلياً / 8080 في الحاوية)
PORT=8080

# ---- سقوف الذاكرة (مضبوطة على حدّ الحاوية المنشورة: 1024MB) ----
# سقف heap الفعلي يُضبط في Dockerfile عبر NODE_OPTIONS وتُسجَّل قيمته في الصحة.
# القاعدة: سقف heap ≤ 70% من حدّ الحاوية، وإلا يقتل الـcgroup العملية قبل أن يضغط V8.
# السقفان التاليان يحفظان مخزون مناطق السيولة من النمو حتى القتل بالـOOM.
LIQUIDITY_LIVE_MAX_ZONES=40000
LIQUIDITY_HISTORY_MAX_ZONES=40000

# ---- الاحتفاظ بالبيانات ----
# أنواع تشخيصية كثيفة الحجم تُحذف بعد هذه المدة (بالأيام). لا تُحذف القرارات ولا الفرص.
RETENTION_DIAGNOSTIC_DAYS=30
# صور المناطق الآلية تُحذف بعد هذه المدة (بالأيام)
RETENTION_IMAGE_DAYS=90

# ---- المراقبة ----
# فترة كتابة عيّنة الصحة في القاعدة (بالدقائق، افتراضي 5) — دليل التشغيل المستمر
HEALTH_SAMPLE_MIN=5
# تأخير تسخين أول معايرة عند غياب معايرة محفوظة (بالمللي ثانية، افتراضي 10 دقائق).
# الغرض: ألا يقضي تشغيل جديد 6 ساعات ببوابة شرائح فارغة. لا يغيّر أي شرط أو عتبة.
STRATEGY2_WARMUP_MS=600000
# دعم لمفتاح التطويع/التشغيل التجريبي لواجهة الظل (★): القياس فقط، والتفعيل يدوي بموافقة
SHADOW_FIXES=
# ★2 قياس: كل كم عملية فحص نُشغّل الكشف مرتين لقياس ثبات معرّف المنطقة (افتراضي 120 →
# ~50 عيّنة في الدورة، أقل من 1% كلفة إضافية). صفر أو أقل من 10 تُرفع إلى 10.
ZONE_ID_SHADOW_STRIDE=120
# ★2: فارق الشموع في المقارنة (افتراضي 4 = الفجوة الواقعية بين دورتي فحص).
# شمعة واحدة تُبخّس العيب: 22.1% مقابل 37.6% بالقياس على بيانات حقيقية.
ZONE_ID_SHADOW_LOOKBACK=4
# ---- الموثوقية ----
# إحياء المحركات المعلقة تلقائياً (1 مُفعَّل، 0 معطّل). يُحيا كل محرك مرة كل 10 دقائق
# بسقف 5 محاولات، ثم تحذير صريح. الكشف وحده لا يكفي لتشغيل طويل بلا مراقبة.
AUTO_REVIVE=1

# ---- فحص مناطق السيولة الحادث (بلا REST لكل رمز وفريم) ----
# التحويل الحادث: الشموع تُقرأ من مخزن البث المجمّع (يُغذّى من بث 1m وحده) والكشف يُشغَّل
# على حدث إغلاق الشمعة. الافتراضي مفعّل (1). ضع 0 لتعطيل التغذية والعودة للمسار القديم.
LIQUIDITY_AGGREGATE=1
# مفتاح الطوارئ: 1 = إعادة المسار القديم (REST لكل رمز وفريم في كل دورة). الافتراضي 0.
LIQUIDITY_LEGACY_REST=0
# سعة مخزن الشموع المجمّع لكل مفتاح (رمز × فريم). الافتراضي 400.
LIQUIDITY_AGGREGATE_CAPACITY=400
# أقل عدد شموع يُقبل للكشف الحي من المخزن (الافتراضي 40). أقل من ذلك يعمل الماسح الاحتياطي.
LIQUIDITY_MIN_BARS=40
# فاصل الماسح الاحتياطي منخفض التردد بالمللي (الافتراضي 600000 = 10 دقائق).
LIQUIDITY_FALLBACK_MS=600000
# حجم دفعة البذر التسلسلي في warmUniverse (الافتراضي 8) — لا نفتح آلاف الطلبات في لحظة.
LIQUIDITY_WARM_BATCH=8

# ---- محرك السيولة v2 (ظلّي — قياس فقط، لا يُغذّي أي قرار منشور) ----
# 0 يعطّل قياس v2 تماماً. الافتراضي 1 (قياس بلا أي أثر على القرارات المنشورة).
LIQUIDITY_V2_SHADOW=1
# كل كم مفتاح (رمز × فريم) تُؤخذ عيّنة مقارنة بين المحركين. الافتراضي 40.
LIQUIDITY_V2_STRIDE=40

# ---- تكاليف التنفيذ في النتائج الصافية (لا تمس أي شرط دخول/خروج/هدف/وقف) ----
# رسوم لكل اتجاه (0.001 = 0.1%) وفرق سعري (0.0005 = 0.05%). تُخصم من النتائج الصافية
# في المعايرة والباك تيست فقط، فيظهر أثرها بجانب الرقم الخام لا بدلاً منه.
TRADE_FEE_PCT=0.001
TRADE_SLIPPAGE_PCT=0.0005

# ---- محدد المعدل الموحّد لكل نداءات بينانس (سبوت ومشتقات وعمق السوق) ----
# عدد مرات إعادة النداء على نفس المضيف بعد 429/418 قبل تجربة مضيف آخر (افتراضي 1).
BINANCE_RATE_RETRIES=1
# سقف الانتظار داخل الطلب الواحد عند الرفض بالمللي (افتراضي 30000). الباقي يُفرض
# كحظر على كل الطلبات في المحدد بدل تعليق دورة كاملة.
BINANCE_RATE_WAIT_CAP_MS=30000

# ---- ★2: قياس معرّف المنطقة المرشَّح (محتوى لا ترتيب) ----
# الشبكات المفحوصة (نسب من السعر). القرار يُتخذ بالقياس: الأقل دوراناً.
ZONE_ID_CANDIDATE_GRIDS=0.001,0.002,0.004

# ---- استمرارية مخزون المناطق وملخص الباك تيست ----
# فاصل حفظ ملخص المخزون بالمللي (افتراضي 600000 = 10 دقائق). الملخص كيلوبايتات فقط.
INVENTORY_SAVE_MS=600000
# نافذة كاش المناطق الآلية بالمللي (افتراضي 120000 = دقيقتان) — يخفّف أثقل جلب في
# النظام (5000 حدث + 60 لقطة + 1000 تغذية راجعة) من كل 30 ثانية إلى كل كتابة فعلية.
AUTO_ZONES_CACHE_MS=120000

# ---- ★5: قياس فرق المعايرة عن الحي ----
# كل كم مهمة معايرة (رمز × فريم) يُعاد قياس فرق معاملات المعايرة عن المحرك الحي.
# الافتراضي 12 — قياس فقط، ولا يُكتب في أي فرصة أو صار محفوظ.
# (يُقرأ من cfg.calibration.parityStride، ويمكن ضبطه برمجياً عند تمرير الإعدادات)
