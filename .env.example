# نموذج متغيرات البيئة — انسخه إلى .env عند الحاجة
# ملاحظة: الخادم يعمل تلقائياً بقيم افتراضية مدمجة في server/db.js
# اضبط هذه القيم فقط إذا أردت استخدام مشروع Supabase مختلف.
SUPABASE_URL=https://<your-supabase-project-url>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# اختياري: فترة المزامنة الدورية لقائمة العملات بالدقائق (افتراضي 30)
SYMBOLS_SYNC_MIN=30

# اختياري: منفذ الخادم (افتراضي 8787 محلياً / 8080 في الحاوية)
PORT=8080
